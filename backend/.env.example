# backend/.env 로 복사해서 사용한다 (.env는 커밋하지 않는다)
# 비밀번호는 CLAUDE.md 10절에서 직접 정한 값을 넣는다
DATABASE_URL=mysql+pymysql://trello:<비밀번호>@127.0.0.1:3306/trello?charset=utf8mb4
# 테스트 전용 DB. 이름에 'test'가 없으면 pytest가 중단된다
TEST_DATABASE_URL=mysql+pymysql://trello:<비밀번호>@127.0.0.1:3306/trello_test?charset=utf8mb4

# 임의의 긴 문자열. 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# 쉼표로 구분. 배포 환경(Nginx가 같은 origin으로 서빙)에서는 비워 둔다
CORS_ORIGINS=http://localhost:5173
